{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Planificador",
  "version": "0.1.0",
  "identifier": "cl.planificador.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Planificador",
        "width": 1400,
        "height": 850,
        "minWidth": 900,
        "minHeight": 500,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis", "dmg", "app"],
    "category": "Productivity",
    "shortDescription": "Planificación de proyectos con carta Gantt",
    "longDescription": "Aplicación de escritorio para planificar proyectos: tareas, subtareas, dependencias, hitos y carta Gantt. Los proyectos se guardan como archivos .planif.",
    "fileAssociations": [
      {
        "ext": ["planif"],
        "name": "Proyecto Planificador",
        "description": "Proyecto de Planificador",
        "role": "Editor"
      }
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
