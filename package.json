{
  "name": "planificador-monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w apps/simple",
    "build": "npm run build -w apps/simple",
    "test": "npm test -w packages/core",
    "lint": "oxlint",
    "typecheck": "npm run typecheck -w packages/core && npm run typecheck -w apps/simple",
    "tauri": "npm run tauri -w apps/simple --"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vitest": "^5.0.5"
  }
}
