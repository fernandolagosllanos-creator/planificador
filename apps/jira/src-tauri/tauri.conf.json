{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Planificador Jira",
  "version": "0.1.0",
  "identifier": "cl.planificador.jira",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5174",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Planificador Jira",
        "width": 1400,
        "height": 850,
        "minWidth": 900,
        "minHeight": 500,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "msi",
      "nsis",
      "dmg",
      "app"
    ],
    "category": "Productivity",
    "shortDescription": "Planificación de proyectos con carta Gantt, integrada con Jira Cloud",
    "longDescription": "Aplicación de escritorio para planificar proyectos (tareas, dependencias, hitos y carta Gantt) vinculados con las incidencias de un proyecto de Jira Cloud. Los proyectos se guardan como archivos .planif.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "windows": {
      "nsis": {
        "languages": [
          "Spanish",
          "English"
        ],
        "displayLanguageSelector": false,
        "installMode": "currentUser"
      },
      "wix": {
        "language": "es-ES"
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEUwMEYzMUVDRTY2MDhDMzgKUldRNGpHRG03REVQNE5rMGlPVU53Z0Z0K3FNS0ZMOW5MTnkwOUVHcFVkVGNCc0ZUT1VKMHQyaEIK",
      "endpoints": [
        "https://raw.githubusercontent.com/fernandolagosllanos-creator/planificador/main/updates/jira/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
